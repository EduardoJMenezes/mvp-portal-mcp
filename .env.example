# A API em Java (mvp-portal-aluno). Toda tool grava e lê por ela: o adaptador
# não abre conexão com o banco. SERVICO_TOKEN é o segredo que prova que o
# comando veio daqui — o mesmo valor vai no serviço da API, que não sobe com
# menos de 32 caracteres. Gere: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_BASE_URL=http://127.0.0.1:8080
SERVICO_TOKEN=

# Vimeo: Personal Access Token de developer.vimeo.com, com os escopos Public e
# Private. Sem token, o adaptador usa o acervo de demonstração embutido.
VIMEO_ACCESS_TOKEN=

# A URL pública deste serviço. É a raiz da página de envio (/enviar/<token>) e
# do OAuth do conector remoto.
MCP_BASE_URL=http://127.0.0.1:8000

# Conector remoto (claude.ai) só fala OAuth. Preenchendo as duas variáveis
# abaixo (mais MCP_BASE_URL), o servidor aceita login no GitHub além do token
# Bearer que o Claude Code usa. Passo a passo em docs/MCP-OAUTH.md.
MCP_OAUTH_GITHUB_CLIENT_ID=
MCP_OAUTH_GITHUB_CLIENT_SECRET=
# Quem do GitHub é qual operador: "login=email,outro=email".
MCP_OAUTH_OPERADORES=

# Só para o proxy OAuth guardar cliente e token entre deploys (tabela
# oauth_mcp_kv). Vazio, fica em memória.
DATABASE_URL=

APP_HOST=127.0.0.1
APP_PORT=8000
